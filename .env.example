# ==== App ====
APP_ENV=development
PROJECT_NAME=Craster Assistant
DEBUG=true
API_V1_STR=/api/v1
ALLOWED_ORIGINS=*

# ==== LLM ====
OPENAI_API_KEY=sk-...
DEFAULT_LLM_MODEL=gpt-5-mini
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=2000
MAX_LLM_CALL_RETRIES=3
LLM_TOTAL_TIMEOUT=60
SESSION_NAMING_ENABLED=true

# ==== Long-term memory (mem0 + pgvector) ====
LONG_TERM_MEMORY_MODEL=gpt-5-nano
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory

# ==== JWT ====
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# ==== Postgres ====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=craster_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ==== Valkey / Redis (optional cache + rate-limit backend) ====
VALKEY_HOST=
VALKEY_PORT=6379
VALKEY_DB=0
VALKEY_PASSWORD=
CACHE_TTL_SECONDS=60

# ==== Langfuse (optional tracing) ====
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ==== Acumatica ERP (Products Simple GI + Sales Simple GI) ====
# Acumatica instance base URL, e.g. https://craster.acumatica.com
ACUMATICA_BASE_URL=
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=
ACUMATICA_TENANT=
ACUMATICA_BRANCH=
# GI names exactly as published in Acumatica (Generic Inquiry screen name)
ACUMATICA_PRODUCTS_GI=ProductsSimple
ACUMATICA_SALES_GI=SalesSimple
# Session cache TTL in seconds (Acumatica cookie session reuse)
ACUMATICA_SESSION_TTL_SECONDS=1200
# Result cache TTL in seconds (catalog/sales data doesn't change every second)
ACUMATICA_RESULT_CACHE_TTL_SECONDS=120
